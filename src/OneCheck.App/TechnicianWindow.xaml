<Window x:Class="OneCheck.App.TechnicianWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneCheck"
        Icon="pack://application:,,,/Assets/onecheck.ico"
        Width="960" Height="560" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" Grid.Row="1" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />

        <DataGrid x:Name="TargetGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                  RowHeight="30" GridLinesVisibility="Horizontal" Background="White"
                  BorderBrush="{StaticResource CardBorder}" HorizontalGridLinesBrush="#EEF0F3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.3*" />
                <DataGridTextColumn Header="Host / IP" Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" />
                <DataGridTextColumn Header="Port TCP" Binding="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <DataGridTextColumn Header="Jml ping" Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                <DataGridTextColumn Header="Batas ms" Binding="{Binding MaxLatencyMs, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <DataGridCheckBoxColumn Header="Kritis" Binding="{Binding Critical, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                <DataGridTextColumn Header="Hasil tes" Binding="{Binding Result}" Width="1.8*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AddButton" Style="{StaticResource ActionButton}" Margin="0,0,8,0"  Click="Add_Click" />
            <Button x:Name="RemoveButton" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Remove_Click" />
            <Button x:Name="TestButton" Style="{StaticResource ActionButton}" Margin="0,0,8,0"  Click="Test_Click" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PhoneLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="PhoneBox" Grid.Column="1" VerticalContentAlignment="Center" Padding="4" />
            <TextBlock x:Name="PinLabel" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox x:Name="PinBox" Grid.Column="3" VerticalContentAlignment="Center" Padding="4" />
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" IsCancel="True" />
                <Button x:Name="SaveButton" Style="{StaticResource ActionButton}" Margin="8,0,0,0" FontWeight="SemiBold" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
