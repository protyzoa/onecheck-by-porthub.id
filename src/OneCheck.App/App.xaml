<Application x:Class="OneCheck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             DispatcherUnhandledException="OnUnhandledException">
    <Application.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
        <SolidColorBrush x:Key="TextMuted" Color="#5F6670" />
        <SolidColorBrush x:Key="CardBorder" Color="#E1E4E8" />
        <!-- Warna brand dari logo OneCheck -->
        <SolidColorBrush x:Key="BrandNavy" Color="#144467" />
        <SolidColorBrush x:Key="BrandCyan" Color="#00AEEF" />

        <!-- Tombol teks kecil untuk pilihan bahasa di header -->
        <Style x:Key="LangButton" TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF1F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol aksi kecil di bagian bawah -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#C9CED6"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF1F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
