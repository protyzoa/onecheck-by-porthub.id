<Window x:Class="OneCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneCheck by PortHub"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimary}"
        Icon="pack://application:,,,/Assets/onecheck.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="RootGrid" Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <!-- Pilihan bahasa -->
                <StackPanel x:Name="LangPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="LangIdButton" Content="ID" Click="LangId_Click" Style="{StaticResource LangButton}"
                            AutomationProperties.Name="Bahasa Indonesia" />
                    <TextBlock Text="|" Foreground="{StaticResource CardBorder}" FontSize="15" VerticalAlignment="Center" />
                    <Button x:Name="LangEnButton" Content="EN" Click="LangEn_Click" Style="{StaticResource LangButton}"
                            AutomationProperties.Name="English" />
                </StackPanel>
                <TextBlock x:Name="HeaderMeta" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="15" Foreground="{StaticResource TextMuted}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo-shield.png" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock VerticalAlignment="Center" FontSize="20">
                        <Run Text="One" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" /><Run Text="Check" FontWeight="Bold" Foreground="{StaticResource BrandCyan}" />
                        <Run x:Name="HeaderCompany" Text="by PortHub" Foreground="{StaticResource TextMuted}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Konten utama -->
        <Grid Grid.Row="1" Margin="24,16,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="ButtonArea" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Logo besar di layar awal & saat tes (disembunyikan di layar hasil agar hasil muat satu layar) -->
                <Image x:Name="BrandLogo" Source="pack://application:,,,/Assets/logo-full.png" Height="162" Margin="0,0,0,24"
                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Tombol status utama -->
                <Button x:Name="MainButton" Width="560" Height="130" Cursor="Hand" Click="MainButton_Click"
                        AutomationProperties.Name="Start Test">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="65"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <Grid>
                        <StackPanel x:Name="ButtonContent" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ButtonIcon" Text="▶" FontFamily="Segoe UI Symbol" FontSize="34"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="ButtonLabel" Text="Start Test" FontSize="34" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Animasi loading berputar -->
                        <Path x:Name="Spinner" Width="64" Height="64" Visibility="Collapsed"
                              Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 32,4 A 28,28 0 1 1 4,32" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>

                <TextBlock x:Name="ProgressText" Margin="0,18,0,0" FontSize="16" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                           Foreground="{StaticResource TextMuted}"
                           Text="Tekan tombol untuk memeriksa koneksi internet Anda." />
            </StackPanel>

            <!-- Hasil -->
            <Border x:Name="ResultCard" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed"
                    Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Kesimpulan -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="19" FontWeight="SemiBold">
                            <Run x:Name="FindingCode" Text="[OK]" Foreground="{StaticResource TextMuted}" />
                            <Run x:Name="FindingMessage" Text="" />
                        </TextBlock>
                        <TextBlock x:Name="FindingAdvice" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="OtherFindings" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- QR code: teknisi scan dari foto untuk dapat data lengkap -->
                        <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Top">
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="6" Background="White">
                                <Image x:Name="QrImage" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <TextBlock x:Name="ScanText" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>

                        <!-- Checklist untuk user -->
                        <Border Grid.Column="0" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                            <ItemsControl x:Name="ChecklistList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontFamily="Segoe UI Symbol"
                                                       FontSize="17" FontWeight="Bold" Width="26" />
                                            <TextBlock Text="{Binding Label}" FontSize="16" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Ringkasan teknis untuk teknisi -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,0,0,0">
                            <ItemsControl x:Name="SummaryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Tombol aksi -->
        <StackPanel x:Name="ActionBar" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,4,0,16" Visibility="Collapsed">
            <Button x:Name="OpenPortalButton" Style="{StaticResource ActionButton}" Click="OpenPortal_Click"
                    Content="🌐  Buka Halaman Login" Visibility="Collapsed" FontWeight="SemiBold" />
            <Button x:Name="SaveImageButton" Style="{StaticResource ActionButton}" Click="SaveImage_Click" Content="📷  Simpan Gambar" />
            <Button x:Name="CopyTextButton" Style="{StaticResource ActionButton}" Click="CopyText_Click" Content="📋  Salin Teks" />
            <Button x:Name="SendButton" Style="{StaticResource ActionButton}" Click="Send_Click" Content="📤  Kirim ke Teknisi" />
        </StackPanel>
    </Grid>
</Window>
